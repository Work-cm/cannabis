# Copy this file to .env.local and fill in your values

# MongoDB Connection String
# Get from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
# Gmail Configuration for Sending Emails
# 1. Enable 2FA on your Gmail account
# 2. Generate App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Admin Email — where order & contact notifications are delivered
# (defaults to GMAIL_USER if unset)
ADMIN_EMAIL=cannabislap78@gmail.com

# Public business email — shown to customers, used as reply-to on their emails
BUSINESS_EMAIL=orders@cannabislap.com

# Bitcoin wallet address shown to customers in their order confirmation email
BTC_WALLET=your-btc-wallet-address

# JWT Secret for Admin Authentication
# Generate a strong random string (e.g., from: https://randomkeygen.com/)
JWT_SECRET=your-super-secret-jwt-key-change-this
